# Python/cache artifacts
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Local editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local runtime outputs
outputs/
logs/

# Generated research artifacts: retain only policy and directory placeholders.
/results/**
!/results/**/
!/results/README.md
!/results/INDEX.md
!/results/**/.gitkeep
!/results/portfolio/*.md
!/results/portfolio/development/manifest.json
!/results/portfolio/development/raw/*.json.gz
!/results/verification/pytest.xml
/results/.pytest_work/
/results/verification/pytest_*/
/results/paper/external/upstream/
/results/paper/external/downloads/
/results/paper/external/python/
/results/paper/external/venv/

# Retired scenario cache; new scenarios belong under results/.
/data/generated_scenarios/**
!/data/generated_scenarios/README.md

# Interrupted writes
*.json.tmp
